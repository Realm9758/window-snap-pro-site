# ─── App ──────────────────────────────────────────────────────────────────────
# Public origin ONLY (no path). The site is served at
# <origin>/mac-window-manager via a rewrite from the bhopstudio project;
# lib/site.ts appends the basePath. Leave unset in production to default to
# https://bhopstudio.com. For local dev set http://localhost:3000
NEXT_PUBLIC_SITE_ORIGIN=http://localhost:3000

# ─── Stripe ───────────────────────────────────────────────────────────────────
# Get from https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# Get from https://dashboard.stripe.com/products → create a ONE-TIME £19 price.
# Must NOT be recurring: checkout uses mode:"payment", which Stripe rejects
# for a recurring price. Server-side only — do not add a NEXT_PUBLIC_ prefix.
STRIPE_PRICE_ID=price_...

# Get from https://dashboard.stripe.com/apikeys (publishable)
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...

# ─── Supabase ─────────────────────────────────────────────────────────────────
# Get from https://app.supabase.com/project/_/settings/api
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Public keys — safe to expose to the browser (used for Supabase Auth)
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# ─── Email (Resend) ───────────────────────────────────────────────────────────
# Get from https://resend.com/api-keys
# Also: verify your sending domain at https://resend.com/domains
RESEND_API_KEY=re_...

# ─── Admin ─────────────────────────────────────────────────────────────────────
# Email address of the admin user — restricts access to /admin/licenses
ADMIN_EMAIL=your@email.com
